# Copy to deploy/.env.prod and fill in. NEVER commit the real .env.prod.
# (deploy/.env.prod is gitignored.)

# ---- Domain / HTTPS (used by Caddy) ----
DOMAIN=yourdomain.com
ACME_EMAIL=you@example.com

# ---- Postgres (used by db + backend) ----
POSTGRES_USER=cybershield
POSTGRES_PASSWORD=CHANGE-ME-long-random
POSTGRES_DB=cybershield

# ---- Backend ----
APP_ENV=production
DEBUG=false
DEMO_MODE=false
SECRET_KEY=CHANGE-ME-generate-a-64-char-random-string
DATABASE_PROVIDER=postgresql
# host is the compose service name "db":
DATABASE_URL=postgresql+psycopg://cybershield:CHANGE-ME-long-random@db:5432/cybershield
# Same origin as the site (served by Caddy) — keep it locked to your domain:
CORS_ORIGINS=https://yourdomain.com
REDIS_ENABLED=false
TASK_BACKEND=eager
RATE_LIMIT_ENABLED=true

# Providers: default to the free, no-key mock/internal engines. Add real keys
# later to enable external AI / threat-intel (then set the matching MOCK_*=false).
MOCK_LLM=true
MOCK_THREAT_INTELLIGENCE=true
OCR_PROVIDER=mock
QR_DECODER=auto

# ---- Content-intelligence engine (no API keys needed) ----
CONTENT_TIMEZONE=Asia/Kolkata
CONTENT_INGESTION_ENABLED=true
CONTENT_SCHEDULER_EMBEDDED=false
CONTENT_STALE_HOURS=12
CONTENT_PAUSE_AFTER_FAILURES=20
CONTENT_RETENTION_DAYS=365

# ---- Message Protection (optional; no paid keys) ----
# Public URL of the site; OAuth redirect URIs are built from it:
#   <PUBLIC_BASE_URL>/api/v1/msgintel/oauth/gmail/callback   (Google Cloud console)
#   <PUBLIC_BASE_URL>/api/v1/msgintel/oauth/outlook/callback (Azure app registration)
PUBLIC_BASE_URL=https://yourdomain.com
# Encrypts stored mail tokens. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Leave empty to hide the Gmail / Outlook connect buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
