# Copy to deploy/.env.prod and fill in. NEVER commit the real .env.prod.
# (deploy/.env.prod is gitignored.)

# ---- Domain / HTTPS (used by Caddy) ----
DOMAIN=yourdomain.com
ACME_EMAIL=you@example.com

# ---- Postgres (used by db + backend) ----
POSTGRES_USER=cybershield
POSTGRES_PASSWORD=CHANGE-ME-long-random
POSTGRES_DB=cybershield

# ---- Backend ----
APP_ENV=production
DEBUG=false
DEMO_MODE=false
SECRET_KEY=CHANGE-ME-generate-a-64-char-random-string
DATABASE_PROVIDER=postgresql
# host is the compose service name "db":
DATABASE_URL=postgresql+psycopg://cybershield:CHANGE-ME-long-random@db:5432/cybershield
# Same origin as the site (served by Caddy) — keep it locked to your domain:
CORS_ORIGINS=https://yourdomain.com
REDIS_ENABLED=false
TASK_BACKEND=eager
RATE_LIMIT_ENABLED=true

# Providers: default to the free, no-key mock/internal engines. Add real keys
# later to enable external AI / threat-intel (then set the matching MOCK_*=false).
MOCK_LLM=true
MOCK_THREAT_INTELLIGENCE=true
OCR_PROVIDER=mock
QR_DECODER=auto
