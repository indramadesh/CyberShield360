# ============================================================
# CyberShield 360 — Environment Configuration (EXAMPLE)
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ============================================================

# ---- App ----
APP_NAME=CyberShield 360
APP_ENV=development            # development | testing | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# ---- Database (abstracted; swap provider without touching business logic) ----
DATABASE_PROVIDER=sqlite       # sqlite | postgresql | mysql
# sqlite (local dev default): file path is derived automatically when URL is blank
DATABASE_URL=
# postgresql example: postgresql+psycopg://user:pass@localhost:5432/cybershield
# mysql example:      mysql+pymysql://user:pass@localhost:3306/cybershield

# ---- Redis / task queue (optional; app runs synchronously if disabled) ----
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
TASK_BACKEND=eager             # eager (in-process) | celery

# ---- Auth ----
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_MIN_LENGTH=10

# ---- Providers (all have a safe mock/local default) ----
LLM_PROVIDER=mock              # mock | openai | anthropic | ollama
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

OCR_PROVIDER=mock              # mock | tesseract | easyocr | cloud
QR_DECODER=auto                # auto (opencv if installed, else mock) | opencv | mock
EMBEDDING_PROVIDER=mock

THREAT_INTEL_PROVIDER=hybrid   # hybrid uses all enabled adapters; mock in dev
GOOGLE_WEBRISK_API_KEY=
PHISHTANK_ENABLED=false
OPENPHISH_ENABLED=false
URLSCAN_API_KEY=

STORAGE_PROVIDER=local         # local | s3 | cloud
STORAGE_LOCAL_PATH=./storage/local
S3_BUCKET=
S3_REGION=

# ---- Feature flags (UI auto-hides disabled modules) ----
ENABLE_URL_SCANNER=true
ENABLE_MESSAGE_SCANNER=true
ENABLE_EMAIL_SCANNER=true
ENABLE_IMAGE_SCANNER=true
ENABLE_QR_SCANNER=true
ENABLE_WEBSITE_SCANNER=true
ENABLE_NEWS=true
ENABLE_CYBER_LAW=true
ENABLE_AWARENESS=true
ENABLE_INCIDENT_RESPONSE=true
ENABLE_BROWSER_EXTENSION=false
ENABLE_USER_REPORTS=true
ENABLE_THREAT_CAMPAIGNS=false

# ---- Privacy / limits ----
STORE_RAW_UPLOADS=false
PII_REDACTION_ENABLED=true
MAX_FILE_SIZE_MB=10
MAX_SCAN_TIME_SECONDS=30

# ---- Rate limiting / request limits ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=30
RATE_LIMIT_EXPENSIVE_PER_MIN=20
MAX_REQUEST_BYTES=15728640

# ---- Threat-intel cache ----
INTEL_CACHE_TTL_SECONDS=3600
INTEL_PERSIST_TTL_DAYS=7
DATA_RETENTION_DAYS=90

# ---- Modes ----
MOCK_THREAT_INTELLIGENCE=true
MOCK_LLM=true
DEMO_MODE=true

# ---- Risk thresholds (configurable; not scientifically universal) ----
RISK_THRESHOLD_SUSPICIOUS=25
RISK_THRESHOLD_HIGH=50
RISK_THRESHOLD_CRITICAL=75

# ---- Content-intelligence engine (no API keys needed) ----
CONTENT_TIMEZONE=Asia/Kolkata
CONTENT_INGESTION_ENABLED=true
# true = run the scheduler inside the API process (dev only); production runs: python -m app.content.worker
CONTENT_SCHEDULER_EMBEDDED=false
CONTENT_STALE_HOURS=12
CONTENT_PAUSE_AFTER_FAILURES=20
CONTENT_RETENTION_DAYS=365
